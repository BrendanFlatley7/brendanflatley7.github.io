---
import "../styles/global.css";
import "../styles/print.css";

import { resume, isExport } from "../data/resolve";
import Header from "../components/Header.astro";
import Summary from "../components/Summary.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Education from "../components/Education.astro";

const title = `${resume.name} — ${resume.headline}`;
const description = resume.summary.slice(0, 155);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <link rel="canonical" href={Astro.site.href} />}
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    {
      /*
       * Two surfaces, one set of components. The PDF is the full resume:
       * skills, then every role's bullets. The site is a short personal page —
       * who he is beside what he's built, then where he's worked and what with.
       * `isExport` is a build-time constant, so only one branch ships.
       */
    }
    {
      isExport ? (
        <main class="resume">
          <Header />
          <Summary />
          <Skills />
          <Experience />
          <Projects />
          <Education />
        </main>
      ) : (
        <main class="resume resume--site">
          <Header />
          <div class="intro">
            <Summary />
            <Projects showcase />
          </div>
          <Experience detail={false} />
          <Skills compact />
          <Education />
        </main>
      )
    }
  </body>
</html>
