---
import "../styles/global.css";
import "../styles/print.css";

import { resume, isExport } from "../data/resolve";
import Header from "../components/Header.astro";
import Summary from "../components/Summary.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Education from "../components/Education.astro";

const title = `${resume.name} — ${resume.headline}`;
// Search engines cut around 155 characters, so cut it here — at the last word
// boundary, so the description never ends mid-word.
const description =
  resume.summary.length <= 155
    ? resume.summary
    : resume.summary.slice(0, resume.summary.lastIndexOf(" ", 155));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <link rel="canonical" href={Astro.site.href} />}
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    {
      /*
       * Two surfaces, one set of components. The PDF is the full resume:
       * every role's bullets, with skills reading as a reference list near the
       * end. The site is a short personal page — who he is beside what he's
       * built, then where he's worked and what with.
       * `isExport` is a build-time constant, so only one branch ships.
       */
    }
    {
      isExport ? (
        <main class="resume">
          <Header />
          <Summary />
          <Experience />
          <Projects />
          <Skills />
          <Education />
        </main>
      ) : (
        <main class="resume resume--site">
          <Header />
          <div class="intro">
            <Summary heading />
            <Projects showcase />
          </div>
          <Experience detail={false} />
          <Skills compact />
          <Education />
        </main>
      )
    }
  </body>
</html>
