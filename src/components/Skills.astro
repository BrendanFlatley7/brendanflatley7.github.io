---
import Section from "./Section.astro";
import { resume } from "../data/resolve";

interface Props {
  /**
   * Both surfaces show the same four labeled lines; the site renders each
   * group's items as pills, the resume runs them inline as text.
   */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { technical } = resume.skills;
---

{
  technical.length > 0 && (
    <Section title={compact ? "Tools & Techniques" : "Technical Skills"}>
      <ul class="skill-lines">
        {technical.map((group) => (
          <li class={compact ? "skill-line skill-line--chips" : "skill-line"}>
            <span class="skill-line__label">{group.group}</span>
            {compact ? (
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              group.items.join(", ")
            )}
          </li>
        ))}
      </ul>
    </Section>
  )
}
