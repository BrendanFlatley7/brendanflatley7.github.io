---
import { resume } from "../data/resolve";
import { displayUrl } from "../utils/format";

const { name, headline, location, hometown, email, phone, links } = resume;

// Only non-empty profile links render.
const profiles = (
  [
    ["GitHub", links.github],
    ["LinkedIn", links.linkedin],
    ["Website", links.website],
  ] satisfies [label: string, url: string][]
).filter(([, url]) => url.length > 0);

// Where he lives and where he's from read as one pair, kept off the headline
// line so neither has to compete with it.
const places = [
  location && `Lives in ${location}`,
  hometown && `From ${hometown}`,
].filter(Boolean) as string[];
---

<header class="masthead">
  <h1 class="masthead__name">{name}</h1>

  {headline && <p class="masthead__identity">{headline}</p>}

  {
    places.length > 0 && (
      <p class="masthead__places">
        {places.map((place, i) => (
          <>
            {i > 0 && <span class="masthead__sep" aria-hidden="true" />}
            <span>{place}</span>
          </>
        ))}
      </p>
    )
  }

  <ul class="contact">
    <li>
      <a class="contact__item" href={`mailto:${email}`}>{email}</a>
    </li>
    {/* Present only when built locally — see .env.local */}
    {
      phone && (
        <li>
          <a class="contact__item" href={`tel:${phone.replace(/[^\d+]/g, "")}`}>
            {phone}
          </a>
        </li>
      )
    }
    {
      profiles.map(([label, url]) => (
        <li>
          <a class="contact__item no-print-url" href={url} aria-label={label}>
            {displayUrl(url)}
          </a>
        </li>
      ))
    }
  </ul>
</header>
