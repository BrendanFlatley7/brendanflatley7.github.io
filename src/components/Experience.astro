---
import Section from "./Section.astro";
import ToolIcon from "./ToolIcon.astro";
import { resume } from "../data/resolve";
import { toISOMonth } from "../utils/format";

interface Props {
  /**
   * The PDF carries every bullet. The site shows where he worked, when, and
   * what he worked with — the detail belongs on the resume he sends.
   */
  detail?: boolean;
}

const { detail = true } = Astro.props;
---

<Section title="Experience">
  {
    resume.experience.map((job) => (
      <article class="job">
        <div class="job__head">
          <h3 class="job__company">
            {job.company}
            {job.location && <span class="job__location">{job.location}</span>}
          </h3>
        </div>

        {/* One employer may hold several roles, including concurrent ones. */}
        {job.roles.map((role) => {
          const startISO = toISOMonth(role.start);
          const endISO = role.end ? toISOMonth(role.end) : undefined;
          return (
            <div class:list={["role", !detail && "role--plain"]}>
              <div class="role__head">
                <h4 class="role__title">
                  {role.title}
                  {role.type && <span class="role__type"> · {role.type}</span>}
                </h4>
                <p class="role__dates">
                  <time datetime={startISO}>{role.start}</time>
                  {" – "}
                  {role.end ? (
                    <time datetime={endISO}>{role.end}</time>
                  ) : (
                    "Present"
                  )}
                </p>
              </div>

              {role.note && <p class="role__note">{role.note}</p>}

              {detail
                ? role.groups.map((group) => (
                    <div class:list={["group", group.label && "group--titled"]}>
                      {/* A lone group needs no subheading — there is nothing to
                          distinguish it from. This is what the site sees once the
                          export-only project groups are filtered out. */}
                      {group.label && role.groups.length > 1 && (
                        <h5 class="group__label">{group.label}</h5>
                      )}
                      <ul class="bullets">
                        {group.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    </div>
                  ))
                : role.tools &&
                  role.tools.length > 0 && (
                    <ul class="toolstrip">
                      {role.tools.map((slug) => (
                        <ToolIcon slug={slug} />
                      ))}
                    </ul>
                  )}
            </div>
          );
        })}
      </article>
    ))
  }
</Section>
